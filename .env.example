# Copy to .env and fill in. Never commit .env.
# Only maintainer scripts (`npm run provision`, `npm run update-prompts`) read this file.
# The local app never uses the admin secret and it never ships in the npm package.

# Kaltura account.
KALTURA_PARTNER_ID=
KALTURA_ADMIN_SECRET=
# Nevada's look and voice, from avatars.listTemplates. Rules: DESIGN.md § Persona.
KALTURA_VISUAL_ID=
KALTURA_VOICE_ID=
# Provisioning writes the agent and widget IDs to server/agent.json.
