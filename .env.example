# Copy to .env and fill in. Never commit .env.

# Web API and proxy
PORT=8080
# Bind address. Defaults to 127.0.0.1 (localhost only); set to 0.0.0.0 to
# accept connections from other hosts.
#HOST=127.0.0.1
# Public URL attendees reach this server on, e.g. https://nevada.example.com.
# Required behind a tunnel or proxy, or every request gets a 421. It builds
# absolute links (handoff URLs) and is the only Host header allowed.
#PUBLIC_ORIGIN=
# 32-byte key, base64. Encrypts AWS tokens at rest and keys each attendee's
# Kaltura userId. Changing it gives every attendee a new userId, so their
# Kaltura-side history starts over.
TOKEN_ENC_KEY=
# In-memory capacity caps, so one attendee (or an attacker) can't fill up
# server memory. Defaults shown; raise only if you've sized the box for it.
#PAIR_MAX=2000
#HANDOFF_MAX=2000
#TOKEN_STORE_MAX=5000

# Kaltura account. The server needs both to mint each attendee's agent
# session; the scripts need them too. The secret never reaches the browser.
KALTURA_PARTNER_ID=
KALTURA_ADMIN_SECRET=
# Nevada's look and voice, from avatars.listTemplates. Rules: DESIGN.md § Persona.
KALTURA_VISUAL_ID=
KALTURA_VOICE_ID=
# Provisioning writes the agent and widget IDs to server/agent.json.

# NEVADA_URL is for pair/index.mjs only. The server prints it filled in as
# part of the pairing command, and `npm run pair` sets it for you. Leave it
# out of .env.
