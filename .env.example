# Copy to .env and fill in. Never commit .env.

# Web API and proxy
PORT=8080
# 32-byte key, base64. Encrypts AWS tokens at rest.
TOKEN_ENC_KEY=

# Kaltura account used by scripts/provision.mjs
KALTURA_PARTNER_ID=
KALTURA_ADMIN_SECRET=
# Nevada's look and voice, from avatars.listTemplates. Rules: DESIGN.md § Persona.
KALTURA_VISUAL_ID=
KALTURA_VOICE_ID=
# Provisioning writes the agent and widget IDs to server/agent.json.
