{
  "name": "nevada-reinvent",
  "version": "0.1.1",
  "description": "Nevada, a live avatar concierge for AWS re:Invent attendees",
  "keywords": [
    "aws",
    "reinvent",
    "kaltura",
    "avatar",
    "concierge",
    "schedule"
  ],
  "homepage": "https://github.com/kaltura/nevada-reinvent-concierge#readme",
  "bugs": {
    "url": "https://github.com/kaltura/nevada-reinvent-concierge/issues"
  },
  "author": "Kaltura",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaltura/nevada-reinvent-concierge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "nevada-reinvent": "server/index.mjs"
  },
  "files": [
    "server/*.mjs",
    "server/public.json",
    "client/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node server/index.mjs",
    "provision": "node --env-file=.env scripts/provision.mjs",
    "update-prompts": "node --env-file=.env scripts/update-prompts.mjs",
    "catalog-tags": "node scripts/catalog-tags.mjs",
    "test": "node --test",
    "eval": "node server/evals/runner.mjs",
    "prepack": "node scripts/write-public.mjs"
  },
  "devDependencies": {
    "@kaltura/intelligent-agents": "https://github.com/kaltura/intelligent-agents-sdk/archive/c581d6b994e09aad0cd74df3550275466d5e7007.tar.gz"
  }
}
